# Copy to .env.production and set your real domain before building.
#
# This single value drives canonical URLs, hreflang links, Open Graph URLs,
# the sitemap and robots.txt. Leave it unset and the build uses
# https://example.com as a placeholder — which would tell search engines the
# canonical version of your site lives on someone else's domain, so set it.
SITE_URL=https://your-domain.com
