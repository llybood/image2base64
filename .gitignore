# ---------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------
/node_modules
/.pnp
.pnp.*
.yarn/cache
.yarn/install-state.gz

# ---------------------------------------------------------------
# Next.js build output
# ---------------------------------------------------------------
# Regenerated by `npm run build`; never commit machine-built artefacts.
/.next/
/out/
/build

# Auto-generated by Next on every dev/build run. It references
# ./.next/types/routes.d.ts, which does not exist in a fresh clone,
# so committing it only produces a dangling reference for editors.
next-env.d.ts
*.tsbuildinfo

# ---------------------------------------------------------------
# Environment variables
# ---------------------------------------------------------------
# SITE_URL lives here. Never commit real values.
# .env.example is the committed template — keep it.
.env*
!.env.example

# ---------------------------------------------------------------
# Local package-manager overrides
# ---------------------------------------------------------------
# A mirror override for machines with a slow route to the default
# registry. Deliberately NOT committed: package-lock.json resolves
# every tarball against registry.npmjs.org, so a checkout is
# reproducible on any CI host regardless of what this file says.
.npmrc

# ---------------------------------------------------------------
# OS / editor / logs
# ---------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.idea/
.vscode/

# ---------------------------------------------------------------
# Deployment
# ---------------------------------------------------------------
.vercel

# ---------------------------------------------------------------
# Local AI assistant state
# ---------------------------------------------------------------
# Session work logs and scratch scripts — stays on this machine.
/.workbuddy/
